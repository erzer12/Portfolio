{
	"extends": "stylelint-config-standard",
	"rules": {
		"color-no-hex": null,
		"function-disallowed-list": ["rgb", "rgba", "hsl", "hsla"],
		"value-keyword-case": null,
		"import-notation": "string",
		"at-rule-no-unknown": [
			true,
			{
				"ignoreAtRules": ["tailwind", "theme"]
			}
		],
		"declaration-property-value-disallowed-list": {
			"color": ["/^(?!var\\(|color-mix\\(|currentColor|inherit|transparent|#)/"],
			"background-color": ["/^(?!var\\(|color-mix\\(|currentColor|inherit|transparent|#)/"],
			"border-color": ["/^(?!var\\(|color-mix\\(|currentColor|inherit|transparent|#)/"]
		}
	}
}
